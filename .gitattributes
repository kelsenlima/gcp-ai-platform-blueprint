* text=auto
# Files executed on Linux (pipeline agents, containers) always use LF.
*.yaml        text eol=lf
*.yml         text eol=lf
*.sh          text eol=lf
*.tf          text eol=lf
*.hcl         text eol=lf
*.py          text eol=lf
Dockerfile*   text eol=lf
.dockerignore text eol=lf
*.gif         binary
*.png         binary
