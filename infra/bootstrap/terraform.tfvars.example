# Copy to terraform.tfvars (git-ignored) and replace every value. All values below are fictitious.

org_id          = "123456789012"
customer_id     = "C00example"
billing_account = "000000-AAAAAA-000000"
folder_name     = "AI Platform"
prefix          = "acme-ai"
region          = "us-central1" # e.g. "southamerica-east1"

labels = {
  managed-by = "terraform"
  platform   = "ai"
}

manage_groups     = true
group_domain      = "example.com"
group_admins_name = "ai-admins"
group_devs_name   = "ai-devs"
group_users_name  = "ai-users"

azdo_org_name                = "example-org"
azdo_project_name            = "AIPlatform"
azdo_service_connection_name = "gcp-ai-platform"
azdo_tenant_id               = "00000000-0000-0000-0000-000000000000"
azdo_org_id                  = "11111111-1111-1111-1111-111111111111"
azdo_service_connection_id   = "22222222-2222-2222-2222-222222222222"
azdo_token_audiences         = ["api://AzureADTokenExchange"]
